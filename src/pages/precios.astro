---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Planes y Precios de Preparación NCLEX-RN | rnnclex.com"
  description="Conoce los planes y precios más accesibles para preparar tu examen NCLEX-RN. Acceso a banco +3500 preguntas, simuladores CAT y NGN."
  canonical="https://rnnclex.com/precios/"
>
  <section class="py-16 bg-[#eff4f7]">
    <div class="max-w-screen-xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-[#2b2c27] mb-4">
        Planes y Precios Accesibles
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Invierte en tu futuro como enfermero/a en Estados Unidos con la mejor relación calidad-precio.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Plan 1 -->
      <div class="border border-gray-200 p-8 rounded-2xl flex flex-col justify-between hover:shadow-lg transition">
        <div>
          <h2 class="text-xl font-bold text-[#2b2c27] mb-2">Acceso 30 Días</h2>
          <p class="text-3xl font-extrabold text-[#0e497c] mb-6">$49 <span class="text-xs text-gray-500 font-normal">USD</span></p>
          <ul class="space-y-3 text-xs text-gray-600 mb-8">
            <li>✓ Banco de +3500 preguntas</li>
            <li>✓ Explicaciones bilingües</li>
            <li>✓ Casos Clínicos NGN</li>
            <li>✓ 1 Simulador CAT</li>
          </ul>
        </div>
        <a href="https://bit.ly/rnnclex_whatsapp" target="_blank" rel="noopener" class="block bg-[#0e497c] text-white font-bold text-xs py-3 px-6 rounded text-center hover:bg-[#0b3b64] transition">
          Obtener Plan 30 Días
        </a>
      </div>

      <!-- Plan 2: Destacado -->
      <div class="border-2 border-[#0e497c] bg-[#eff4f7]/40 p-8 rounded-2xl flex flex-col justify-between shadow-md relative">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#0e497c] text-white text-[10px] uppercase font-bold px-3 py-1 rounded-full">Más Popular</span>
        <div>
          <h2 class="text-xl font-bold text-[#2b2c27] mb-2">Acceso 90 Días</h2>
          <p class="text-3xl font-extrabold text-[#0e497c] mb-6">$89 <span class="text-xs text-gray-500 font-normal">USD</span></p>
          <ul class="space-y-3 text-xs text-gray-600 mb-8">
            <li>✓ Banco de +3500 preguntas completo</li>
            <li>✓ Explicaciones bilingües e ilimitadas</li>
            <li>✓ Casos Clínicos NGN completos</li>
            <li>✓ Simuladores CAT Ilimitados</li>
            <li>✓ Readiness Assessments ilimitados</li>
          </ul>
        </div>
        <a href="https://bit.ly/rnnclex_whatsapp" target="_blank" rel="noopener" class="block bg-[#0e497c] text-white font-bold text-xs py-3 px-6 rounded text-center hover:bg-[#0b3b64] transition">
          Obtener Plan 90 Días
        </a>
      </div>

      <!-- Plan 3 -->
      <div class="border border-gray-200 p-8 rounded-2xl flex flex-col justify-between hover:shadow-lg transition">
        <div>
          <h2 class="text-xl font-bold text-[#2b2c27] mb-2">Acceso 180 Días</h2>
          <p class="text-3xl font-extrabold text-[#0e497c] mb-6">$139 <span class="text-xs text-gray-500 font-normal">USD</span></p>
          <ul class="space-y-3 text-xs text-gray-600 mb-8">
            <li>✓ Acceso total por 6 meses</li>
            <li>✓ Todo lo incluido en Plan 90 Días</li>
            <li>✓ Soporte con tutores en línea</li>
            <li>✓ Garantía de Aprobación</li>
          </ul>
        </div>
        <a href="https://bit.ly/rnnclex_whatsapp" target="_blank" rel="noopener" class="block bg-[#0e497c] text-white font-bold text-xs py-3 px-6 rounded text-center hover:bg-[#0b3b64] transition">
          Obtener Plan 180 Días
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
