---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site.mjs";

const features = [
  "Más de 3500 preguntas en inglés y español, con justificaciones",
  "Simuladores adaptativos CAT como en el examen real",
  "Preguntas del NCLEX Next Generation (NGN)",
  "Readiness Assessment para saber si estás listo",
  "Más de 400 guías de estudio en español",
  "Preparación guiada, no solo banco de preguntas",
];

const faqs = [
  {
    question: "¿Cuánto cuesta rnnclex.com?",
    answer: `La suscripción cuesta USD ${site.offer.price} al mes. Es el único plan e incluye todo el contenido de la plataforma.`,
  },
  {
    question: "¿Cómo pago?",
    answer: "Entras a la plataforma, inicias sesión y completas el pago de forma segura con Stripe.",
  },
  {
    question: "¿Qué incluye la suscripción?",
    answer: "Banco de más de 3500 preguntas en inglés y español con justificaciones, simuladores adaptativos CAT, preguntas del NCLEX Next Generation (NGN), Readiness Assessment, más de 400 guías de estudio en español y preparación guiada.",
  },
  {
    question: "¿Es más barato que Archer Review, UWorld o Bootcamp?",
    answer: "Sí. Por USD 19 al mes tienes una preparación completa y bilingüe pensada para enfermeros hispanos, mucho más accesible que los programas premium.",
  },
  {
    question: "¿El NCLEX se presenta en español?",
    answer: "No. El NCLEX-RN se presenta en inglés. Por eso la plataforma es bilingüe: estudias y practicas en inglés y en español.",
  },
];
---

<BaseLayout
  title="Precio: NCLEX bilingüe por USD 19 al mes"
  description="Preparación NCLEX-RN bilingüe para enfermeros hispanos por USD 19 al mes: +3500 preguntas, CAT, NGN y guías en español. Mucho más accesible que Archer o UWorld."
  canonical="https://rnnclex.com/precios/"
  type="faq"
  faqs={faqs}
>
  <section class="py-14 md:py-16 bg-gradient-to-b from-[#eaf3fb] to-white">
    <div class="max-w-screen-xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 tracking-tight mb-4">Un solo plan. Todo incluido.</h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Preparación NCLEX completa, en inglés y en español, hecha para enfermeros hispanos — mucho más accesible que Archer Review, UWorld o Bootcamp.
      </p>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-screen-md mx-auto px-4">
      <div class="border-2 border-[#0e497c] rounded-2xl p-8 md:p-10 shadow-md bg-white">
        <p class="text-xs font-bold uppercase tracking-widest text-[#0e497c]">Suscripción mensual</p>
        <p class="mt-3 flex items-end gap-1">
          <span class="text-6xl font-extrabold text-[#0e497c]">USD {site.offer.price}</span>
          <span class="text-lg font-medium text-slate-500 mb-1">/ mes</span>
        </p>
        <ul class="mt-8 space-y-3 text-slate-700">
          {features.map((f) => <li class="flex gap-3"><span class="text-emerald-600 font-bold">✓</span><span>{f}</span></li>)}
        </ul>
        <a
          href={site.appUrl}
          data-cta="app"
          class="mt-10 block bg-[#0e497c] hover:bg-[#0b3b64] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#003388] text-white font-bold text-lg min-h-[48px] py-3 px-6 rounded-xl text-center tracking-wide transition"
        >
          Empezar por USD {site.offer.price}/mes
        </a>
        <p class="mt-4 text-xs text-slate-500 text-center">Entras a la plataforma, inicias sesión y pagas de forma segura con Stripe. Cancela cuando quieras.</p>
      </div>

      <p class="mt-8 text-center text-sm text-slate-600">
        ¿Quieres ver cómo son las preguntas? <a href="/preparacion-nclex/preguntas-practica/" class="text-[#0e497c] font-semibold underline hover:text-[#003388]">Mira el banco de preguntas gratis</a>.
      </p>
    </div>
  </section>

  <section class="py-14 bg-[#eff4f7]">
    <div class="max-w-screen-lg mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900 tracking-tight mb-8">Preguntas frecuentes</h2>
      <div class="space-y-3">
        {
          faqs.map((f) => (
            <details class="bg-white rounded-xl border border-slate-200 hover:border-[#0e497c]/40 transition">
              <summary class="cursor-pointer font-semibold text-slate-900 px-5 py-4 min-h-[44px] flex items-center justify-between gap-4 rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#003388]">
                {f.question}
                <span class="text-[#0e497c] text-xl leading-none">+</span>
              </summary>
              <p class="mt-1 pb-5 px-5 text-slate-600 leading-relaxed">{f.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-14 bg-[#0e497c] text-white">
    <div class="max-w-screen-md mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">¿Listo para empezar?</h2>
      <p class="mt-3 text-blue-100 leading-relaxed">Accede hoy a todo el banco de preguntas, los simuladores CAT y las guías en español por una sola suscripción de USD {site.offer.price} al mes.</p>
      <a
        href={site.appUrl}
        data-cta="app"
        class="mt-7 inline-block bg-white text-[#0e497c] font-bold px-8 min-h-[48px] py-3 rounded-xl tracking-wide hover:bg-blue-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white transition"
      >
        Empezar por USD {site.offer.price}/mes
      </a>
      <p class="mt-4 text-xs text-blue-200">Pago seguro con Stripe dentro de la plataforma.</p>
    </div>
  </section>
</BaseLayout>
