---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppCta from "@/components/global/AppCta.astro";

const posts = (await getCollection("articles"))
  .filter((p) => p.data.section === "proceso-licencia-homologacion")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => d.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout
  title="Licencia y homologación de enfermería en EE. UU."
  description="Guías en español sobre CGFNS, ATT, costos del NCLEX y homologación del título de enfermería para enfermeros extranjeros en Estados Unidos."
  canonical="https://rnnclex.com/proceso-licencia-homologacion/"
  type="service"
>
  <section class="bg-gradient-to-b from-[#eaf3fb] to-white border-b border-slate-200">
    <div class="max-w-screen-lg mx-auto px-4 py-12 md:py-14">
      <nav aria-label="Migas de pan" class="text-xs text-slate-500 flex items-center gap-1.5 mb-4">
        <a href="/" class="hover:text-[#0e497c]">Inicio</a><span aria-hidden="true">/</span><a href="/blog/" class="hover:text-[#0e497c]">Blog</a>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">Licencia y homologación para enfermeros extranjeros</h1>
      <p class="mt-3 text-lg text-slate-600 max-w-2xl">Del título en tu país a la licencia en Estados Unidos: CGFNS, ATT, inscripción, costos y requisitos por estado.</p>
    </div>
  </section>

  <section class="bg-white py-10 md:py-12">
    <div class="max-w-screen-lg mx-auto px-4">
      <div class="grid gap-5 sm:grid-cols-2">
        {
          posts.map((post) => (
            <a href={`/${post.data.section}/${post.data.slug}/`} class="group flex flex-col rounded-2xl border border-slate-200 p-6 hover:border-[#0e497c]/50 hover:shadow-md transition bg-white">
              <h2 class="text-lg font-semibold text-slate-900 leading-snug group-hover:text-[#0e497c]">{post.data.title}</h2>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed line-clamp-3 flex-1">{post.data.description}</p>
              <p class="mt-4 text-xs text-slate-400">{fmt(post.data.date)}</p>
            </a>
          ))
        }
      </div>

      <div class="mt-10 rounded-2xl bg-[#eaf3fb] p-6 md:p-8">
        <h2 class="text-xl font-bold text-[#0e497c]">Guías por estado y fechas del examen</h2>
        <p class="mt-2 text-slate-700">Revisa los requisitos de tu estado, cómo inscribirte y cómo elegir la fecha de tu examen.</p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm font-semibold">
          <a href="/examen-nclex/requisitos/" class="bg-[#0e497c] text-white px-4 py-2 rounded-lg hover:bg-[#0b3b64]">Requisitos por estado</a>
          <a href="/examen-nclex/inscripcion/" class="text-[#0e497c] px-4 py-2">Inscripción y registro</a>
          <a href="/examen-nclex/fechas/" class="text-[#0e497c] px-4 py-2">Fechas y centros</a>
          <a href="/precios/" class="text-[#0e497c] px-4 py-2">Prepárate por USD 19/mes</a>
        </div>
      </div>
    </div>
  </section>

  <AppCta />
</BaseLayout>
