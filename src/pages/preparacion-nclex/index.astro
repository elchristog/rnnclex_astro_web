---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Preparación NCLEX-RN | Banco de Preguntas, CAT y Cursos | rnnclex.com"
  description="Domina el examen NCLEX-RN con +3500 preguntas explicadas, simuladores adaptativos CAT, pruebas Readiness y casos NGN en español e inglés."
  canonical="https://rnnclex.com/preparacion-nclex/"
>
  <section class="py-16 bg-[#eff4f7]">
    <div class="max-w-screen-xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-[#2b2c27] mb-6">
        Herramientas de Preparación NCLEX-RN
      </h1>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
        Diseñamos el ecosistema más completo para enfermeros hispanos. Practica con nuestro banco adaptativo, mide tus probabilidades reales de aprobación y domina el Next Generation NCLEX (NGN).
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Item 1 -->
      <div class="p-8 bg-gray-50 rounded-xl border border-gray-100 flex flex-col justify-between">
        <div>
          <span class="text-2xl mb-4 block">🗄️</span>
          <h2 class="text-xl font-bold text-[#2b2c27] mb-3">Banco de Preguntas +3500</h2>
          <p class="text-sm text-gray-600 leading-relaxed mb-6">
            Preguntas redactadas por expertos en enfermería, con explicaciones detalladas (racionalizaciones) en español e inglés técnico para asegurar tu aprendizaje.
          </p>
        </div>
        <a href="/preparacion-nclex/preguntas-practica/" class="inline-block bg-[#0e497c] text-white text-xs font-bold py-3 px-6 rounded text-center hover:bg-[#0b3b64] transition">
          Iniciar Práctica Gratis
        </a>
      </div>

      <!-- Item 2 -->
      <div class="p-8 bg-gray-50 rounded-xl border border-gray-100 flex flex-col justify-between">
        <div>
          <span class="text-2xl mb-4 block">💻</span>
          <h2 class="text-xl font-bold text-[#2b2c27] mb-3">Simuladores CAT & Readiness</h2>
          <p class="text-sm text-gray-600 leading-relaxed mb-6">
            El simulador adaptativo (Computerized Adaptive Testing) simula el algoritmo oficial de Pearson VUE para calcular tu probabilidad de pasar el examen.
          </p>
        </div>
        <a href="/preparacion-nclex/simuladores-examen/CAT/" class="inline-block bg-[#0e497c] text-white text-xs font-bold py-3 px-6 rounded text-center hover:bg-[#0b3b64] transition">
          Probar Simulador CAT
        </a>
      </div>

      <!-- Item 3 -->
      <div class="p-8 bg-gray-50 rounded-xl border border-gray-100 flex flex-col justify-between">
        <div>
          <span class="text-2xl mb-4 block">🎧</span>
          <h2 class="text-xl font-bold text-[#2b2c27] mb-3">Cursos Online y Revisiones</h2>
          <p class="text-sm text-gray-600 leading-relaxed mb-6">
            Estructuras de estudio paso a paso para repasar farmacología, enfermería médico-quirúrgica, maternidad y pediatría con enfoque bilingüe.
          </p>
        </div>
        <a href="/preparacion-nclex/cursos/" class="inline-block bg-[#0e497c] text-white text-xs font-bold py-3 px-6 rounded text-center hover:bg-[#0b3b64] transition">
          Ver Cursos Disponibles
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
