---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Guía Completa del Examen NCLEX-RN | rnnclex.com"
  description="Todo lo que necesitas saber sobre el examen NCLEX-RN: Requisitos por estado, proceso de inscripción en Pearson VUE y fechas."
  canonical="https://rnnclex.com/examen-nclex/"
>
  <section class="py-16 bg-[#eff4f7]">
    <div class="max-w-screen-xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-[#2b2c27] mb-4">
        Guía Completa del Examen NCLEX-RN
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Toda la logística y requisitos para registrarte y tomar el examen de licencia en Estados Unidos.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="p-6 bg-gray-50 border border-gray-200 rounded-xl">
        <h2 class="text-lg font-bold text-[#0e497c] mb-2">Requisitos por Estado</h2>
        <p class="text-xs text-gray-600 mb-4">Descubre los requisitos del Board of Nursing de Florida, Nueva York, Texas y otros estados.</p>
        <a href="/examen-nclex/requisitos/" class="text-xs font-bold text-[#0e497c] hover:underline">Ver Requisitos →</a>
      </div>

      <div class="p-6 bg-gray-50 border border-gray-200 rounded-xl">
        <h2 class="text-lg font-bold text-[#0e497c] mb-2">Inscripción y Registro</h2>
        <p class="text-xs text-gray-600 mb-4">Guía paso a paso sobre cómo registrarte en Pearson VUE y obtener tu ATT (Authorization to Test).</p>
        <a href="/examen-nclex/inscripcion/" class="text-xs font-bold text-[#0e497c] hover:underline">Ver Guía de Registro →</a>
      </div>

      <div class="p-6 bg-gray-50 border border-gray-200 rounded-xl">
        <h2 class="text-lg font-bold text-[#0e497c] mb-2">Fechas y Centros</h2>
        <p class="text-xs text-gray-600 mb-4">Consulta la disponibilidad de centros examinadores Pearson VUE internacionales y en EE.UU.</p>
        <a href="/examen-nclex/fechas/" class="text-xs font-bold text-[#0e497c] hover:underline">Ver Fechas y Centros →</a>
      </div>
    </div>
  </section>
</BaseLayout>
