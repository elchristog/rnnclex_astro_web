---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppCta from "@/components/global/AppCta.astro";

const all = (await getCollection("articles")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const labels = {
  "estrategias-examen": "Estrategias para el examen",
  "proceso-licencia-homologacion": "Proceso de licencia y homologación",
};
const chip = {
  "estrategias-examen": "bg-blue-50 text-[#0e497c]",
  "proceso-licencia-homologacion": "bg-emerald-50 text-emerald-700",
};
const fmt = (d) => d.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" });
const [featured, ...rest] = all;
const url = (p) => `/${p.data.section}/${p.data.slug}/`;
---

<BaseLayout
  title="Blog NCLEX para enfermeros hispanos"
  description="Guías en español sobre el NCLEX-RN: estrategias de estudio, NGN, CGFNS, ATT, costos, requisitos y homologación de tu título de enfermería en Estados Unidos."
  canonical="https://rnnclex.com/blog/"
  type="service"
>
  <section class="bg-gradient-to-b from-[#eaf3fb] to-white border-b border-slate-200">
    <div class="max-w-screen-lg mx-auto px-4 py-12 md:py-14">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#0e497c]">Blog</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">NCLEX para enfermeros hispanos</h1>
      <p class="mt-3 text-lg text-slate-600 max-w-2xl">
        Guías claras, en español, para aprobar el NCLEX-RN y obtener tu licencia de enfermería en Estados Unidos.
      </p>
    </div>
  </section>

  <section class="bg-white py-10 md:py-12">
    <div class="max-w-screen-lg mx-auto px-4">
      {featured && (
        <a href={url(featured)} class="block rounded-2xl bg-[#0e497c] text-white p-7 md:p-10 mb-10 hover:bg-[#0b3b64] transition">
          <p class="text-xs font-semibold uppercase tracking-wider text-blue-200">Lo más reciente · {labels[featured.data.section]}</p>
          <h2 class="mt-3 text-2xl md:text-3xl font-bold leading-snug max-w-3xl">{featured.data.title}</h2>
          <p class="mt-3 text-blue-100 max-w-3xl leading-relaxed line-clamp-3">{featured.data.description}</p>
          <p class="mt-5 text-sm font-semibold">Leer artículo →</p>
        </a>
      )}

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          rest.map((post) => (
            <a href={url(post)} class="group flex flex-col rounded-2xl border border-slate-200 p-6 hover:border-[#0e497c]/50 hover:shadow-md transition bg-white">
              <span class={`self-start text-[11px] font-semibold px-2.5 py-1 rounded-full ${chip[post.data.section] ?? "bg-slate-100 text-slate-700"}`}>{labels[post.data.section]}</span>
              <h2 class="mt-3 text-lg font-semibold text-slate-900 leading-snug group-hover:text-[#0e497c] line-clamp-3">{post.data.title}</h2>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed line-clamp-3 flex-1">{post.data.description}</p>
              <p class="mt-4 text-xs text-slate-400">{fmt(post.data.date)}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <AppCta />
</BaseLayout>
