---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppCta from "@/components/global/AppCta.astro";

const all = (await getCollection("articles")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const labels = {
  "estrategias-examen": "Estrategias para el examen",
  "proceso-licencia-homologacion": "Proceso de licencia y homologación",
};
---

<BaseLayout
  title="Blog NCLEX para enfermeros hispanos"
  description="Guías en español sobre el NCLEX-RN: estrategias de estudio, NGN, CGFNS, ATT, costos, requisitos y homologación de tu título de enfermería en Estados Unidos."
  canonical="https://rnnclex.com/blog/"
  type="service"
>
  <section class="bg-[#eff4f7] border-b border-gray-200">
    <div class="max-w-screen-lg mx-auto px-4 py-12 md:py-16">
      <h1 class="text-3xl md:text-5xl font-bold text-[#2b2c27] leading-tight">Blog NCLEX para enfermeros hispanos</h1>
      <p class="mt-4 text-lg text-gray-600 max-w-3xl">
        Guías claras, en español, para aprobar el NCLEX-RN y obtener tu licencia de enfermería en Estados Unidos.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="max-w-screen-lg mx-auto px-4 grid gap-6 md:grid-cols-2">
      {
        all.map((post) => (
          <a href={`/${post.data.section}/${post.data.slug}/`} class="block rounded-xl border border-gray-200 p-6 hover:border-[#0e497c] hover:shadow-sm transition">
            <p class="text-xs font-bold uppercase tracking-wider text-[#0e497c]">{labels[post.data.section]}</p>
            <h2 class="mt-2 text-xl font-semibold text-[#2b2c27] leading-snug">{post.data.title}</h2>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">{post.data.description}</p>
            <p class="mt-4 text-xs text-gray-400">
              {post.data.date.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" })}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <AppCta />
</BaseLayout>
