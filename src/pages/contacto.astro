---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contacto | Asistencia y Consultas"
  description="Ponte en contacto con el equipo de rnnclex.com. Estamos listos para ayudarte en tu proceso de preparación para el examen NCLEX-RN."
  canonical="https://rnnclex.com/contacto/"
>
  <section class="py-16 bg-[#eff4f7]">
    <div class="max-w-screen-xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-[#2b2c27] mb-4">
        Contacto
      </h1>
      <p class="text-lg text-gray-600 max-w-xl mx-auto">
        ¿Tienes dudas sobre los planes o necesitas orientación? Escríbenos y con gusto te asistiremos.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-screen-md mx-auto px-4">
      <div class="bg-gray-50 p-8 rounded-2xl border border-gray-200 shadow-sm">
        <form class="space-y-6">
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2" for="name">Nombre Completo</label>
            <input type="text" id="name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:border-[#0e497c]" placeholder="Ej. Ana María Pérez" />
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2" for="email">Correo Electrónico</label>
            <input type="email" id="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:border-[#0e497c]" placeholder="ana@ejemplo.com" />
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2" for="message">Mensaje</label>
            <textarea id="message" rows="4" required class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:border-[#0e497c]" placeholder="Escribe tu consulta aquí..."></textarea>
          </div>

          <button type="submit" class="w-full bg-[#0e497c] hover:bg-[#0b3b64] text-white font-bold py-4 rounded-lg text-sm transition tracking-wider shadow">
            Enviar Mensaje
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
