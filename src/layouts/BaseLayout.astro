---
import Tracking from "@/components/fundations/head/Tracking.astro";
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
import Navigation from "@/components/global/Navigation.astro";
import Footer from "@/components/global/Footer.astro";
import { site } from "@/data/site.mjs";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: 'home' | 'service' | 'faq' | 'article';
  faqs?: Array<{ question: string; answer: string }>;
  datePublished?: string;
  dateModified?: string;
  about?: string;
  ogImage?: string;
}

const { title, description, type, faqs, datePublished, dateModified, about, ogImage } = Astro.props;
// Si la página no indica su canonical, se calcula desde la ruta (siempre con barra final)
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = Astro.props.canonical ?? new URL(canonicalPath, site.url).href;
---

<html lang="es" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} canonical={canonical} type={type} faqs={faqs} datePublished={datePublished} dateModified={dateModified} about={about} ogImage={ogImage} />
    <Tracking />
    <script is:inline src="https://px.get-ryze.ai/px.js?key=rz_pk_e473d2562deb6586aba4f11f97ad6f78"></script>
  </head>
  <body class="flex flex-col bg-white min-h-dvh">
    <Navigation />
    <main class="flex-grow"><slot /></main>
    <Footer />
  </body>
</html>
