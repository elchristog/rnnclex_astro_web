---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppCta from "@/components/global/AppCta.astro";

interface Props {
  title: string;
  seoTitle?: string;
  description?: string;
  canonical: string;
  faqs?: Array<{ question: string; answer: string }>;
  type?: "service" | "article";
  datePublished?: string;
  kicker?: string;
}

const { title, seoTitle, description, canonical, faqs = [], type = "service", datePublished, kicker } = Astro.props;
const jsonType = type === "article" ? "article" : faqs.length > 0 ? "faq" : "service";
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  canonical={canonical}
  type={jsonType}
  faqs={faqs}
  datePublished={datePublished}
>
  <section class="bg-[#eff4f7] border-b border-gray-200">
    <div class="max-w-screen-lg mx-auto px-4 py-12 md:py-16">
      {kicker && <p class="text-xs font-bold uppercase tracking-widest text-[#0e497c] mb-3">{kicker}</p>}
      <h1 class="text-3xl md:text-5xl font-bold text-[#2b2c27] leading-tight">{title}</h1>
    </div>
  </section>

  <section class="bg-white py-10 md:py-14">
    <div class="max-w-screen-lg mx-auto px-4">
      <div class="prose prose-lg max-w-none prose-headings:text-[#0e497c] prose-a:text-[#0e497c] prose-img:rounded-xl">
        <slot />
      </div>
    </div>
  </section>

  {
    faqs.length > 0 && (
      <section class="bg-[#eff4f7] py-12">
        <div class="max-w-screen-lg mx-auto px-4">
          <h2 class="text-2xl md:text-3xl font-semibold text-[#2b2c27] mb-8">Preguntas frecuentes</h2>
          <div class="space-y-3">
            {faqs.map((f) => (
              <details class="bg-white rounded-lg border border-gray-200 p-5">
                <summary class="cursor-pointer font-semibold text-[#2b2c27]">{f.question}</summary>
                <p class="mt-3 text-gray-600 leading-relaxed">{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <AppCta />
</BaseLayout>
