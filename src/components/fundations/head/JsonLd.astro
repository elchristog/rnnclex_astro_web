---
interface Props {
  type?: 'home' | 'service' | 'faq' | 'article';
  title?: string;
  description?: string;
  url?: string;
  faqs?: Array<{ question: string; answer: string }>;
  datePublished?: string;
}

const {
  type = 'home',
  title = 'rnnclex.com | Preparación NCLEX-RN bilingüe para enfermeros hispanos',
  description = 'Plataforma de preparación del examen NCLEX-RN en inglés y español para enfermeros hispanos: +3500 preguntas, simuladores CAT y NGN, y preparación guiada.',
  url = 'https://rnnclex.com',
  faqs = [],
  datePublished = '2026-01-01'
} = Astro.props;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOccupationalProgram",
  "name": "Preparación NCLEX-RN bilingüe para enfermeros hispanos",
  "description": description,
  "provider": {
    "@type": "Organization",
    "name": "rnnclex.com",
    "alternateName": "rnnclex",
    "url": "https://rnnclex.com",
    "logo": "https://rnnclex.com/logo.webp",
    "sameAs": [
      "https://www.youtube.com/@rnnclex-usa",
      "https://www.instagram.com/rnnclex.usa",
      "https://www.facebook.com/rnnclex.usa",
      "https://www.linkedin.com/company/rnnclex-com/",
      "https://www.tiktok.com/@rnnclex.com"
    ]
  },
  "occupationalCategory": "Registered Nurse (RN)",
  "educationalProgramMode": "online",
  "inLanguage": ["es", "en"],
  "offers": {
    "@type": "Offer",
    "category": "Suscripción mensual de preparación NCLEX-RN",
    "price": "19",
    "priceCurrency": "USD",
    "url": "https://rnnclex.com/precios/",
    "availability": "https://schema.org/InStock"
  }
};

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

const articleSchema = type === 'article' ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "mainEntityOfPage": url,
  "datePublished": datePublished,
  "inLanguage": "es",
  "author": {
    "@type": "Person",
    "name": "Alejandra Barreto",
    "honorificSuffix": "RN, BSN",
    "jobTitle": "Líder del Programa rnnclex",
    "url": "https://rnnclex.com/equipo/",
    "worksFor": {
      "@type": "Organization",
      "name": "rnnclex.com",
      "url": "https://rnnclex.com"
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": "rnnclex.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://rnnclex.com/logo.webp"
    }
  }
} : null;

// BreadcrumbList desde la ruta canonica (no aplica a la home)
const crumbNames: Record<string, string> = {
  "preparacion-nclex": "Preparación NCLEX",
  "examen-nclex": "Guía del examen",
  "recursos-nclex": "Recursos",
  "proceso-licencia-homologacion": "Licencia y homologación",
  "estrategias-examen": "Estrategias",
  "simuladores-examen": "Simuladores",
  "requisitos": "Requisitos por estado",
  "blog": "Blog",
  "precios": "Precios",
  "faq": "FAQ"
};
const pathSegments = new URL(url, 'https://rnnclex.com').pathname.split('/').filter(Boolean);
const breadcrumbSchema = pathSegments.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://rnnclex.com/" },
    ...pathSegments.map((seg, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": crumbNames[seg] ?? seg.replace(/-/g, " ").replace(/^./, (c) => c.toUpperCase()),
      "item": "https://rnnclex.com/" + pathSegments.slice(0, i + 1).join("/") + "/"
    }))
  ]
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
