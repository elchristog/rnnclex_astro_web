---
interface Props {
  type?: 'home' | 'service' | 'faq' | 'article';
  title?: string;
  description?: string;
  url?: string;
  faqs?: Array<{ question: string; answer: string }>;
  datePublished?: string;
}

const {
  type = 'home',
  title = 'RNNCLEX - Plataforma y Guía de Preparación NCLEX-RN para Enfermeros Hispanos',
  description = 'La plataforma especializada en preparación del examen NCLEX-RN, simuladores NGN en español, homologación de título y visa EB-3 para Estados Unidos.',
  url = 'https://rnnclex.com',
  faqs = [],
  datePublished = '2026-01-01'
} = Astro.props;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOccupationalProgram",
  "name": "Programa de Preparación NCLEX-RN y Homologación de Enfermería para EE.UU.",
  "description": description,
  "provider": {
    "@type": "Organization",
    "name": "RNNCLEX",
    "url": "https://rnnclex.com",
    "logo": "https://rnnclex.com/logo.webp",
    "email": "soporte@rnnclex.com",
    "sameAs": [
      "https://www.youtube.com/@rnnclex",
      "https://www.instagram.com/rnnclex",
      "https://www.facebook.com/rnnclex"
    ]
  },
  "occupationalCategory": "Registered Nurse (RN)",
  "educationalProgramMode": "online",
  "offers": {
    "@type": "Offer",
    "category": "Preparación NCLEX-RN y Asesoría de Homologación"
  }
};

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

const articleSchema = type === 'article' ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "mainEntityOfPage": url,
  "datePublished": datePublished,
  "author": {
    "@type": "Organization",
    "name": "RNNCLEX"
  },
  "publisher": {
    "@type": "Organization",
    "name": "RNNCLEX",
    "logo": {
      "@type": "ImageObject",
      "url": "https://rnnclex.com/logo.webp"
    }
  }
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
