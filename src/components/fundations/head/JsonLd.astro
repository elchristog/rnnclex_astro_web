---
interface Props {
  type?: 'home' | 'service' | 'faq' | 'article' | 'collection' | 'webpage' | 'about' | 'aboutPerson' | 'contact' | 'precios';
  title?: string;
  description?: string;
  url?: string;
  faqs?: Array<{ question: string; answer: string }>;
  datePublished?: string;
  dateModified?: string;
  about?: string;
}

const {
  type = 'home',
  title = 'rnnclex.com | Preparación NCLEX-RN bilingüe para enfermeros hispanos',
  description = 'Plataforma de preparación del examen NCLEX-RN en inglés y español para enfermeros hispanos: +3500 preguntas, simuladores CAT y NGN, y preparación guiada.',
  url = 'https://rnnclex.com/',
  faqs = [],
  datePublished = '2026-01-01',
  dateModified,
  about
} = Astro.props;

const SITE = 'https://rnnclex.com';
const path = new URL(url, SITE).pathname;

// Entidad: nombre de MARCA (no el dominio) + razón social. Una sola definición completa;
// el resto de bloques la referencian por @id.
const BRAND = 'RNNCLEX';
const LEGAL_NAME = 'ENFERMERAEEU LLC';
const ORG_ID = SITE + '/#organization';

const organization = {
  "@type": "Organization",
  "@id": ORG_ID,
  "name": BRAND,
  "legalName": LEGAL_NAME,
  "alternateName": ["rnnclex", "rnnclex.com"],
  "url": SITE + '/',
  "logo": SITE + '/logo.webp',
  "sameAs": [
    "https://www.youtube.com/@rnnclex-usa",
    "https://www.instagram.com/rnnclex.usa",
    "https://www.facebook.com/rnnclex.usa",
    "https://www.linkedin.com/company/rnnclex-com/",
    "https://www.tiktok.com/@rnnclex.com"
  ]
};

// Referencia corta a la entidad para los demás bloques (sin repetir la definición).
const orgRef = { "@type": "Organization", "@id": ORG_ID, "name": BRAND };

// Indices de seccion y blog: CollectionPage. El resto de rutas: WebPage.
const COLLECTION_PATHS = new Set([
  '/blog/',
  '/preparacion-nclex/',
  '/preparacion-nclex/preguntas-practica/',
  '/preparacion-nclex/simuladores-examen/',
  '/preparacion-nclex/cursos/',
  '/examen-nclex/',
  '/recursos-nclex/',
  '/proceso-licencia-homologacion/',
  '/estrategias-examen/'
]);

// El tipo real se deduce PRIMERO de la ruta canonica: la ruta manda sobre el prop
// (asi /precios/ recibe su WebPage+Offer aunque la pagina pase type="faq").
// Los props de la pagina solo matizan (article, faq, collection) fuera de esas rutas.
let kind: string;
if (path === '/') kind = 'home';
else if (path === '/precios/') kind = 'precios';
else if (path === '/equipo/') kind = 'aboutPerson';
else if (path === '/quienes-somos/') kind = 'about';
else if (path === '/contacto/') kind = 'contact';
else if (COLLECTION_PATHS.has(path)) kind = 'collection';
else if (type === 'article') kind = 'article';
else if (type === 'faq') kind = 'faq';
else if (type === 'collection') kind = 'collection';
else if (['about', 'aboutPerson', 'contact', 'precios', 'webpage'].includes(type)) kind = type;
else kind = 'webpage';

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

const articleSchema = kind === 'article' ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "mainEntityOfPage": { "@type": "WebPage", "@id": url },
  "datePublished": datePublished,
  "dateModified": dateModified ?? datePublished,
  "inLanguage": "es",
  "author": {
    "@type": "Person",
    "name": "Alejandra Barreto",
    "honorificSuffix": "RN, BSN",
    "jobTitle": "Líder del Programa rnnclex",
    "url": SITE + '/equipo/',
    "worksFor": { ...orgRef, "url": SITE + '/' }
  },
  "publisher": {
    ...orgRef,
    "logo": {
      "@type": "ImageObject",
      "url": SITE + '/logo.webp'
    }
  },
  ...(about ? {
    "about": { "@type": "WebPage", "url": about },
    "mentions": { "@type": "WebPage", "url": about }
  } : {})
} : null;

// Producto + oferta citable por las IA desde datos estructurados (solo portada).
// Los datos coinciden con lo visible en la portada: USD 19 / mes y prueba gratis.
// Sin aggregateRating ni Review: no hay reseñas verificables de terceros todavía.
const productSchema = kind === 'home' ? {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": SITE + '/#suscripcion',
  "name": "Suscripción rnnclex: preparación NCLEX-RN bilingüe",
  "description": "Preparación NCLEX-RN en español e inglés para enfermeros hispanos: +3500 preguntas bilingües con justificaciones, simuladores CAT, preguntas NGN (estudios de caso, bow-tie y respuesta múltiple extendida), Readiness Assessment, +400 guías de estudio en español, sesiones grupales en vivo con docentes, mentoría 1:1, tests de terminología médica, diagnóstico y repaso de puntos débiles y plan de estudio guiado. Todo en una sola suscripción de USD 19 al mes, con prueba gratis; cancelas cuando quieras.",
  "image": SITE + '/logo.webp',
  "category": "Preparación para el examen NCLEX-RN",
  "url": SITE + '/',
  "brand": { "@type": "Brand", "name": BRAND },
  "manufacturer": orgRef,
  "offers": [
    {
      "@type": "Offer",
      "name": "Suscripción mensual rnnclex",
      "price": "19.00",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "19.00",
        "priceCurrency": "USD",
        "billingDuration": 1,
        "unitCode": "MON"
      },
      "url": SITE + '/precios/',
      "availability": "https://schema.org/InStock",
      "seller": orgRef
    },
    {
      "@type": "Offer",
      "name": "Prueba gratis",
      "price": "0.00",
      "priceCurrency": "USD",
      "url": SITE + '/prueba-gratis/',
      "availability": "https://schema.org/InStock",
      "seller": orgRef
    }
  ]
} : null;

const pageSchemas: Record<string, Record<string, unknown> | null> = {
  // home = WebSite (publisher por referencia) + Organization (un solo bloque) + Product
  home: {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "rnnclex.com",
    "alternateName": "rnnclex",
    "url": SITE + '/',
    "inLanguage": ["es", "en"],
    "publisher": { "@id": ORG_ID }
  },
  // /precios/ = WebPage con la oferta unica (USD 19/mes)
  precios: {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": url,
    "inLanguage": "es",
    "isPartOf": { "@type": "WebSite", "name": "rnnclex.com", "url": SITE + '/' },
    "offers": {
      "@type": "Offer",
      "category": "Suscripción mensual de preparación NCLEX-RN",
      "price": "19",
      "priceCurrency": "USD",
      "url": url,
      "availability": "https://schema.org/InStock"
    }
  },
  // /equipo/ = AboutPage con Person (autora y lider del programa)
  aboutPerson: {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": title,
    "description": description,
    "url": url,
    "inLanguage": "es",
    "isPartOf": { "@type": "WebSite", "name": "rnnclex.com", "url": SITE + '/' },
    "mainEntity": {
      "@type": "Person",
      "name": "Alejandra Barreto",
      "honorificSuffix": "RN, BSN",
      "jobTitle": "Líder del Programa rnnclex",
      "url": url,
      "worksFor": { ...orgRef, "url": SITE + '/' }
    }
  },
  // /quienes-somos/ = AboutPage
  about: {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": title,
    "description": description,
    "url": url,
    "inLanguage": "es",
    "isPartOf": { "@type": "WebSite", "name": "rnnclex.com", "url": SITE + '/' }
  },
  // /contacto/ = ContactPage
  contact: {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": title,
    "description": description,
    "url": url,
    "inLanguage": "es",
    "isPartOf": { "@type": "WebSite", "name": "rnnclex.com", "url": SITE + '/' }
  },
  // Indices de seccion y blog = CollectionPage
  collection: {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "description": description,
    "url": url,
    "inLanguage": "es",
    "isPartOf": { "@type": "WebSite", "name": "rnnclex.com", "url": SITE + '/' }
  },
  // Todo lo demas (paginas de estado, guias, terminos, qbank) = WebPage
  webpage: {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": url,
    "inLanguage": "es",
    "isPartOf": { "@type": "WebSite", "name": "rnnclex.com", "url": SITE + '/' }
  },
  faq: null,
  article: null
};
const pageSchema = pageSchemas[kind] ?? null;

// BreadcrumbList desde la ruta canonica (no aplica a la home)
const crumbNames: Record<string, string> = {
  "preparacion-nclex": "Preparación NCLEX",
  "examen-nclex": "Guía del examen",
  "recursos-nclex": "Recursos",
  "proceso-licencia-homologacion": "Licencia y homologación",
  "estrategias-examen": "Estrategias",
  "simuladores-examen": "Simuladores",
  "requisitos": "Requisitos por estado",
  "blog": "Blog",
  "precios": "Precios",
  "faq": "FAQ"
};
const pathSegments = path.split('/').filter(Boolean);
const breadcrumbSchema = pathSegments.length > 0 && kind !== 'home' ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": SITE + '/' },
    ...pathSegments.map((seg, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": crumbNames[seg] ?? seg.replace(/-/g, " ").replace(/^./, (c) => c.toUpperCase()),
      "item": SITE + '/' + pathSegments.slice(0, i + 1).join("/") + '/'
    }))
  ]
} : null;
---

{kind === 'home' && <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...organization })} />}
{pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
{productSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
