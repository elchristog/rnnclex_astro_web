---
import { site } from "@/data/site.mjs";

const mainNav = [
  {
    label: "Preparación NCLEX",
    href: "/preparacion-nclex/",
    children: [
      { label: "Banco de preguntas bilingüe", href: "/preparacion-nclex/preguntas-practica/" },
      { label: "Simulador CAT", href: "/preparacion-nclex/simuladores-examen/cat/" },
      { label: "Readiness Assessment", href: "/preparacion-nclex/simuladores-examen/readiness-assessment/" },
      { label: "Cursos online", href: "/preparacion-nclex/cursos/" },
    ]
  },
  {
    label: "Guía del examen",
    href: "/examen-nclex/",
    children: [
      { label: "Requisitos por estado", href: "/examen-nclex/requisitos/" },
      { label: "Inscripción y registro", href: "/examen-nclex/inscripcion/" },
      { label: "Fechas y centros", href: "/examen-nclex/fechas/" },
    ]
  },
  {
    label: "Recursos",
    href: "/recursos-nclex/",
    children: [
      { label: "Web app y app móvil", href: "/recursos-nclex/app/" },
      { label: "Libros y guías", href: "/recursos-nclex/libros-y-guias/" },
      { label: "Videos de apoyo", href: "/recursos-nclex/videos/" },
      { label: "Tutores expertos", href: "/recursos-nclex/tutores/" },
    ]
  },
  { label: "Blog", href: "/blog/" },
  { label: "Precios", href: "/precios/" },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-200">
  <div class="max-w-screen-xl mx-auto px-4 h-14 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="rnnclex.com, inicio">
      <img src="/images/rn_nclex_logo.webp" alt="rnnclex.com logo" class="h-8 w-8 object-contain" width="32" height="32" />
      <span class="font-semibold text-base text-[#0e497c] tracking-tight">rnnclex<span class="text-slate-400 font-normal">.com</span></span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
      {mainNav.map((item) => (
        <div class="relative group">
          <a href={item.href} class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-[#0e497c] rounded-md hover:bg-slate-100 transition flex items-center gap-1">
            {item.label}
            {item.children && <svg class="w-3 h-3 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>}
          </a>
          {item.children && (
            <div class="absolute left-0 top-full pt-2 hidden group-hover:block group-focus-within:block w-60">
              <div class="bg-white shadow-lg rounded-xl py-2 border border-slate-200">
                {item.children.map((child) => (
                  <a href={child.href} class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-[#0e497c]">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.appLoginUrl} data-cta="login" class="hidden sm:inline-block text-sm font-medium text-slate-700 hover:text-[#0e497c] px-3 py-2 transition">
        Ingresar
      </a>
      <a href={site.appUrl} data-cta="app" class="bg-[#0e497c] hover:bg-[#0b3b64] text-white text-sm font-semibold px-4 py-2 rounded-lg transition whitespace-nowrap">
        Empezar · USD {site.offer.price}/mes
      </a>

      <details class="lg:hidden relative">
        <summary class="list-none cursor-pointer p-2 rounded-md hover:bg-slate-100" aria-label="Abrir menú">
          <svg class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="absolute right-0 top-full mt-2 w-72 max-h-[80vh] overflow-y-auto bg-white border border-slate-200 rounded-xl shadow-xl p-3">
          {mainNav.map((item) => (
            <div class="py-1">
              <a href={item.href} class="block px-3 py-2 text-sm font-semibold text-[#0e497c]">{item.label}</a>
              {item.children && item.children.map((child) => (
                <a href={child.href} class="block pl-6 pr-3 py-1.5 text-sm text-slate-600 hover:text-[#0e497c]">{child.label}</a>
              ))}
            </div>
          ))}
          <a href={site.appLoginUrl} data-cta="login" class="block px-3 py-2 mt-1 text-sm font-medium text-slate-700 border-t border-slate-100">Ingresar</a>
        </div>
      </details>
    </div>
  </div>
</header>
