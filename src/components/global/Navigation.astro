---
const mainNav = [
  {
    label: "Preparación NCLEX",
    href: "/preparacion-nclex/",
    children: [
      { label: "Preguntas de Práctica", href: "/preparacion-nclex/preguntas-practica/" },
      { label: "Quiz", href: "/preparacion-nclex/preguntas-practica/" },
      { label: "Readiness Assessment", href: "/preparacion-nclex/simuladores-examen/readiness-assessment/" },
      { label: "CAT (Computer Adaptive Test)", href: "/preparacion-nclex/simuladores-examen/CAT/" },
      { label: "Cursos Online", href: "/preparacion-nclex/cursos/" },
      { label: "Prueba Gratuita", href: "/preparacion-nclex/preguntas-practica/" },
    ]
  },
  {
    label: "Guía del Examen",
    href: "/examen-nclex/",
    children: [
      { label: "Requisitos por Estado", href: "/examen-nclex/requisitos/" },
      { label: "Inscripción y Registro", href: "/examen-nclex/inscripcion/" },
      { label: "Fechas y Centros", href: "/examen-nclex/fechas/" },
    ]
  },
  {
    label: "Recursos",
    href: "/recursos-nclex/",
    children: [
      { label: "App Móvil", href: "/recursos-nclex/app/" },
      { label: "Libros y Guías", href: "/recursos-nclex/libros-y-guias/" },
      { label: "Videos de Apoyo", href: "/recursos-nclex/videos/" },
      { label: "Tutores Expertos", href: "/recursos-nclex/tutores/" },
    ]
  },
  { label: "Blog", href: "/blog/" },
  { label: "Precios", href: "/precios/" },
];
---

<!-- Main Sticky Header -->
<header class="sticky top-0 z-50 bg-[#eff4f7]/95 backdrop-blur border-b border-gray-200">
  <div class="max-w-screen-xl mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="bg-white p-1.5 rounded-xl border border-gray-200/80 shadow-sm group-hover:shadow transition flex items-center justify-center">
        <img src="/images/rn_nclex_logo.webp" alt="rnnclex.com logo" class="h-9 w-9 object-contain rounded-lg" width="36" height="36" />
      </div>
      <span class="font-bold text-xl text-[#0e497c] tracking-tight">rnnclex.com</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-6" aria-label="Navegación principal">
      {mainNav.map((item) => (
        <div class="relative group py-2">
          <a href={item.href} class="text-sm font-semibold text-[#0e497c] uppercase tracking-wider hover:text-emerald-700 transition flex items-center gap-1">
            {item.label}
            {item.children && <span class="text-xs">▾</span>}
          </a>

          {item.children && (
            <div class="absolute left-0 top-full hidden group-hover:block w-56 bg-white shadow-xl rounded-lg py-2 border border-gray-100 transition-all">
              {item.children.map((child) => (
                <a href={child.href} class="block px-4 py-2 text-xs font-semibold text-gray-700 hover:bg-[#eff4f7] hover:text-[#0e497c]">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- Action Buttons -->
    <div class="flex items-center gap-3">
      <a href="/login/" class="text-xs font-bold text-[#0e497c] border-2 border-[#a0ccf2] hover:bg-[#a0ccf2]/20 px-4 py-2 rounded uppercase tracking-wider transition">
        LOGIN
      </a>
      <a href="/preparacion-nclex/preguntas-practica/" class="bg-[#0e497c] hover:bg-[#0b3b64] text-white text-xs font-bold px-4 py-2.5 rounded uppercase tracking-wider shadow transition">
        TEST GRATIS
      </a>
    </div>
  </div>
</header>

