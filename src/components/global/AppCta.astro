---
import { site } from "@/data/site.mjs";
---

<section class="bg-[#0e497c] text-white py-14">
  <div class="max-w-screen-md mx-auto px-4 text-center">
    <h2 class="text-2xl md:text-3xl font-semibold mb-3">Prepárate para el NCLEX en inglés y en español</h2>
    <p class="text-gray-200 mb-8 leading-relaxed">
      +3500 preguntas bilingües, simuladores CAT, NGN y guías en español, con preparación guiada. Una suscripción de USD {site.offer.price} al mes, mucho más accesible que Archer Review, UWorld o Bootcamp.
    </p>
    <a
      href={site.appUrl}
      data-cta="app"
      class="inline-block bg-white text-[#0e497c] font-bold px-8 py-4 rounded tracking-wide hover:bg-gray-100 transition"
    >
      Empezar ahora — USD {site.offer.price}/mes
    </a>
    <p class="text-xs text-gray-300 mt-4">El pago se realiza dentro de la plataforma, de forma segura con Stripe.</p>
  </div>
</section>
